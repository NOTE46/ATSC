# Copy this file to .env and fill in the API keys for the providers you use.
# ATSC supports Gemini (GEMINI_API_KEY), Groq (GROQ_API_KEY), and OpenRouter (OPENROUTER_API_KEY);
# the active vision_provider in config.json or the GUI selects which one is used.
# If the active provider's key is missing or empty, detection falls back to the local YOLO model
# set as ambulance_model in config.json.
# .env is read once at startup, so restart the app after editing. Real environment variables override .env.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
